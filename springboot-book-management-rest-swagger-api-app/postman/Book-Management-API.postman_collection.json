    {
      "name": "Books",
      "item": [
        {
          "name": "Create Book",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has success field\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Book created with correct data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data.title).to.eql('Sample Book');",
                  "    pm.collectionVariables.set(\"bookId\", jsonData.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"978-0-999999-99-9\",\n  \"title\": \"Sample Book\",\n  \"description\": \"A great book about programming\",\n  \"publicationDate\": \"2024-01-15\",\n  \"price\": 29.99,\n  \"stockQuantity\": 100,\n  \"language\": \"English\",\n  \"pageCount\": 350,\n  \"categoryId\": 1,\n  \"publisherId\": 1,\n  \"authorIds\": [1]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "Get All Books (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?page=0&size=10&sortBy=title&direction=ASC",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {"key": "page", "value": "0"},
                {"key": "size", "value": "10"},
                {"key": "sortBy", "value": "title"},
                {"key": "direction", "value": "ASC"}
              ]
            }
          }
        },
